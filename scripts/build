#!/usr/bin/env bash
set -euo pipefail
project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source_id=$(printf '%s' "$project_dir" | sha256sum | cut -c1-16)
build_dir=${VELORA_BUILD_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/velora-shell/build/$source_id}
jobs=${VELORA_BUILD_JOBS:-2}
for tool in cmake pkg-config make; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'Velora build: dependência obrigatória ausente: %s. Execute ./scripts/preflight.\n' "$tool" >&2
        exit 1
    fi
done
for module in spectrum visualizer; do
    cmake -S "$project_dir/native/$module" -B "$build_dir/$module" -DCMAKE_BUILD_TYPE=Release >&2
    cmake --build "$build_dir/$module" --parallel "$jobs" >&2
done
for artifact in spectrum/qml/Velora/Native/qmldir spectrum/qml/Velora/Native/libveloranativeplugin.so \
                visualizer/qml/Velora/Visualizer/qmldir visualizer/qml/Velora/Visualizer/libvelora-visualizerplugin.so; do
    if [[ ! -s "$build_dir/$artifact" ]]; then
        printf 'Velora build: artefato obrigatório ausente: %s\n' "$artifact" >&2
        exit 1
    fi
done
python3 "$project_dir/scripts/native-blur" build "$build_dir/hyprland" --jobs "$jobs" >&2 || true
printf '%s\n' "$build_dir"
