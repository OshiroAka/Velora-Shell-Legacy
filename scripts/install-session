#!/usr/bin/env python3
"""Connect this checkout to the user's session without copying its source."""
import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--skip-hypr", action="store_true")
parser.add_argument("--without-infinite-desktop", action="store_true")
parser.add_argument("--with-infinite-desktop", action="store_true")
parser.add_argument("--without-fanplus", action="store_true", help="Ignorar a instalação opcional de Fan+; não altera a ventoinha")
parser.add_argument("--install-fanplus-deps", action="store_true", help="Instalar dependências Fan+ dos repositórios Arch/CachyOS no notebook suportado")
args = parser.parse_args()
if args.without_fanplus and args.install_fanplus_deps:
    parser.error("--without-fanplus e --install-fanplus-deps são incompatíveis")
config_home = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
bin_dir = Path.home() / ".local/bin"
bin_dir.mkdir(parents=True, exist_ok=True)
for name in ("velora", "velora-shell", "Velora", "velyrics", "infinite-desktop", "cmatrix"):
    source = root / "scripts" / ("velora" if name in {"Velora", "velora-shell"} else "velora-cmatrix" if name == "cmatrix" else name)
    target = bin_dir / name
    if target.is_dir():
        raise SystemExit(f"Refusing to replace a directory: {target}")
    temporary = target.with_name(target.name + ".new")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(source)
    temporary.replace(target)
subprocess.run([str(root / "scripts/init-config")], check=True)
feature = config_home / "velora-shell/infinite-desktop"
if args.without_infinite_desktop:
    feature.unlink(missing_ok=True)
else:
    feature.touch()
if not args.skip_hypr:
    directory = config_home / "hypr"
    directory.mkdir(parents=True, exist_ok=True)
    main = directory / "hyprland.conf"
    include = directory / "velora-hyprland.conf"
    rules = subprocess.run([sys.executable, str(root / "scripts/native-blur"), "rules",
                            str(root / "config/hyprland.conf.in")], capture_output=True, text=True)
    if rules.returncode:
        raise SystemExit(rules.stderr.strip() + "\nConfiguração Hyprland preservada; use --skip-hypr ou instale os headers/binário corretos.")
    snippet = rules.stdout.replace("@ROOT@", str(root))
    if not args.without_infinite_desktop:
        canvas = (root / "scripts/infinite-desktop.conf").read_text()
        canvas = re.sub(r'(?<=exec, )infinite-desktop\b', '"' + str(root / "scripts/infinite-desktop") + '"', canvas)
        (directory / "infinite-desktop.conf").write_text(canvas)
        snippet += f"\nsource = {directory / 'infinite-desktop.conf'}\n"
    include.write_text(snippet)
    text = main.read_text() if main.exists() else ""
    # Consolidate previously managed includes; leave other compositor settings intact.
    text = re.sub(r'^\s*source\s*=.*(?:velora-hyprland|project-helix)\.conf\s*$', '', text, flags=re.M)
    main.write_text(text.rstrip() + f"\nsource = {include}\n")
print("Velora Shell installed from " + str(root))
if not args.without_fanplus:
    command = [sys.executable, str(root / "scripts/install-fanplus")]
    if args.install_fanplus_deps:
        command.append("--install-deps")
    if subprocess.run(command, check=False).returncode != 0:
        print("Velora instalado; Fan+ continua pendente. Siga as instruções acima e execute novamente scripts/install-fanplus.")
