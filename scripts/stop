#!/usr/bin/env bash
set -euo pipefail
project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
qs_executable=$(python3 "$project_dir/scripts/preflight" --quickshell)
export PATH="$(dirname "$qs_executable"):$PATH"
for surface in editorHide settingsHide lockPreviewHide; do
    qs -p "$project_dir" ipc call composition "$surface" >/dev/null 2>&1 || true
done
sleep 0.8
qs kill -p "$project_dir" >/dev/null 2>&1 || true
for attempt in {1..50}; do
    if ! qs -p "$project_dir" list 2>/dev/null | rg -Fq "Config path: $project_dir/shell.qml"; then
        break
    fi
    if [[ "$attempt" == 50 ]]; then
        printf 'Velora Shell did not stop within five seconds.\n' >&2
        exit 1
    fi
    sleep 0.1
done
# Keep the ABI-verified library resident. Destruction clears its shapes; a
# restart can reuse it without unloading hooks from the user's compositor.
