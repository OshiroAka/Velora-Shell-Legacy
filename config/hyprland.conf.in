# Velora Shell: generated by install.sh
exec-once = "@ROOT@/scripts/velora-wallpaper-apply" restore
exec-once = "@ROOT@/scripts/velora" start
misc {
    force_default_wallpaper = 0
    disable_hyprland_logo = true
}
# Workspace direction follows navigation; shell layers stay fixed.
animations {
    bezier = veloraWorkspaceSlide, 0.4, 0, 0.2, 1
    animation = workspaces, 1, 9, veloraWorkspaceSlide, slidevert
    animation = workspacesIn, 1, 9, veloraWorkspaceSlide, slidevert
    animation = workspacesOut, 1, 9, veloraWorkspaceSlide, slidevert
}
layerrule = blur on, match:namespace ^velora-shell-(topbar|unified-bar|shared-widgets|editor|lock-preview-desktop|lock-preview-panel|left-menu|drawers|frame)$
layerrule = blur_popups on, match:namespace ^velora-shell-(topbar|unified-bar|shared-widgets|editor|lock-preview-desktop|lock-preview-panel|left-menu|drawers|frame)$
layerrule = ignore_alpha 0.02, match:namespace ^velora-shell-(topbar|unified-bar|shared-widgets|editor|lock-preview-desktop|lock-preview-panel|left-menu|drawers|frame)$
layerrule = blur on, match:namespace ^velora-notification-frame$
layerrule = blur_popups on, match:namespace ^velora-notification-frame$
layerrule = ignore_alpha 0.02, match:namespace ^velora-notification-frame$
layerrule = blur on, match:namespace ^velora-topbar$
layerrule = ignore_alpha 0.01, match:namespace ^velora-topbar$
layerrule = blur off, match:namespace ^velora-wallpaper-selector$
bind = SUPER, K, exec, "@ROOT@/scripts/velora" ipc velora topWallpaper
bind = SUPER, W, exec, "@ROOT@/scripts/velora" ipc velora search
bind = SUPER, R, exec, "@ROOT@/scripts/velora" ipc velora settings
bind = SUPER, F, exec, "@ROOT@/scripts/velora-browser"
unbind = , XF86AudioRaiseVolume
unbind = , XF86AudioLowerVolume
unbind = , XF86MonBrightnessUp
unbind = , XF86MonBrightnessDown
bindel = , XF86AudioRaiseVolume, exec, "@ROOT@/scripts/velora-rail-adjust" volume up
bindel = , XF86AudioLowerVolume, exec, "@ROOT@/scripts/velora-rail-adjust" volume down
bindel = , XF86MonBrightnessUp, exec, "@ROOT@/scripts/velora-rail-adjust" brightness up
bindel = , XF86MonBrightnessDown, exec, "@ROOT@/scripts/velora-rail-adjust" brightness down
# Visual lock; configure a separate authenticated locker when required.
bind = SUPER, L, exec, "@ROOT@/scripts/velora-lock"
bind = , Print, exec, "@ROOT@/scripts/velora-screenshot-select" full
bind = SHIFT, Print, exec, "@ROOT@/scripts/velora-screenshot-select" select
bind = , XF86SelectiveScreenshot, exec, "@ROOT@/scripts/velora-screenshot-select" select
